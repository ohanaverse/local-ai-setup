#!/opt/homebrew/bin/bash
# qwen3.8-benchmark — Compare the four qwen3.8 backends (ISOLATED runs)
#
# Strategy: local MLX/GGUF models share Apple Silicon GPU/RAM and would
# distort each other's benchmarks. So:
#   - Ollama: `ollama stop <model>` unloads the model from RAM
#             (daemon keeps running on :11434; model reloads on demand)
#   - oMLX:   `omlx stop` halts the service entirely
#   - OpenRouter: cloud, always live
#
# Measures:
#   - Time to First Token (TTFT)  — prefill latency
#   - Total generation time
#   - Tokens generated
#   - Throughput (tokens/sec)
#
# Usage:
#   qwen3.8-benchmark             # default: 200-token generation
#   qwen3.8-benchmark 100         # custom max_tokens

set -e

MAX_TOKENS="${1:-200}"
PROMPT="${2:-Explain in detail the differences between REST and GraphQL APIs, including trade-offs in caching, partial responses, and tooling. Be thorough.}"

# Shared build_payload/run_streaming/isolate_one/ensure_all_local_started/
# write_table_header helpers, also used by ornith-1.5-benchmark.
source "$(dirname "$0")/lib/benchmark-common.sh"

# Use associative arrays — declare -A must come BEFORE assignment
declare -A DIRECT_URLS
declare -A DIRECT_MODELS
declare -A LITELLM_MODELS
DIRECT_URLS[ollama]="http://localhost:11434/api/chat"
DIRECT_URLS[omlx]="http://localhost:8000/v1/chat/completions"
DIRECT_URLS[mtplx]="http://localhost:8003/v1/chat/completions"
DIRECT_MODELS[ollama]="qwen3.8:27b-mlx"
DIRECT_MODELS[omlx]="Qwen3.8-27B-4bit"
DIRECT_MODELS[mtplx]="Youssofal/Qwen3.8-27B-MTPLX-Optimized-Quality"
LITELLM_MODELS[ollama]="ollama/qwen3.8:27b-mlx"
LITELLM_MODELS[omlx]="omlx/Qwen3.8-27B-4bit"
LITELLM_MODELS[mtplx]="mtplx/Youssofal/Qwen3.8-27B-MTPLX-Optimized-Quality"

LITELLM_URL="http://localhost:4000/v1/chat/completions"
# Prefer the LaunchAgent-exported env var; fall back to reading the plist directly
# so the script still works when invoked from a shell that doesn't inherit the
# LaunchAgent environment (e.g., a manual `bash` from the terminal).
LITELLM_API_KEY="${LITELLM_API_KEY:-$(grep -m1 -A1 'LITELLM_MASTER_KEY' ~/Library/LaunchAgents/local.litellm.proxy.plist 2>/dev/null | tail -1 | sed -E 's/.*<string>(.*)<\/string>.*/\1/')}"

# OpenRouter (cloud) — direct API access
OPENROUTER_DIRECT_URL="https://openrouter.ai/api/v1/chat/completions"
# Same pattern: env var first, plist as fallback.
OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-$(grep -m1 -A1 'OPENROUTER_API_KEY' ~/Library/LaunchAgents/local.litellm.proxy.plist 2>/dev/null | tail -1 | sed -E 's/.*<string>(.*)<\/string>.*/\1/')}"

declare -a OPENROUTER_MODELS=(
    "qwen/qwen3.8-flash"
    "qwen/qwen3.8-27b"
    "qwen/qwen3.8-2.4t-a95b"
    "qwen/qwen3.8-max"
)

# --- Service management ----------------------------------------------------

# Isolation lives in bin/llm-isolate-provider (also used by `modelman
# benchmark`); this script calls it with model-name env overrides instead of
# duplicating the stop/start/warmup logic here. Fails hard: without the
# helper on PATH, isolation (and therefore valid results) is not possible.
ISOLATE_HELPER="$(cd "$(dirname "$0")/../bin" && pwd)/llm-isolate-provider"

# Map this script's backend keys to the helper's provider ids.
declare -A ISOLATE_ID
ISOLATE_ID[ollama]="ollama"
ISOLATE_ID[omlx]="omlx"
ISOLATE_ID[mtplx]="mtplx"

# Env var per backend (helper naming: LLM_ISOLATE_<PROVIDER>_MODEL).
# ISOLATE_ENV[mtplx] is intentionally omitted — isolate_one() forwards its
# model as a positional arg instead (mtplx is single-model-per-process, like
# mlx_lm_server's target/draft positional args).
declare -A ISOLATE_ENV
ISOLATE_ENV[ollama]="LLM_ISOLATE_OLLAMA_MODEL"
ISOLATE_ENV[omlx]="LLM_ISOLATE_OMLX_4BIT_MODEL"

# --- Main ------------------------------------------------------------------

OUTFILE="/tmp/qwen3.8-benchmark-$(date +%Y%m%d-%H%M%S).md"
{
    echo "# qwen3.8 Benchmark Results (ISOLATED runs)"
    echo
    echo "**Date**: $(date)"
    echo "**max_tokens**: $MAX_TOKENS"
    echo "**Mode**: Local backends run in isolation — before each test, all local models are unloaded (Ollama) or fully stopped (oMLX). Only the one being tested has its model loaded. OpenRouter is cloud and unaffected."
    echo
    echo "## Prompt"
    echo
    echo '```'
    echo "$PROMPT"
    echo '```'
    echo
} > "$OUTFILE"

ensure_all_local_started

echo ""
echo "=== qwen3.8 Benchmark — max_tokens=$MAX_TOKENS ==="
echo "    (isolated local runs; OpenRouter is always live)"
echo ""

# --- Isolated local tests: direct + litellm-routed, one backend at a time ---
write_table_header "Isolated local runs (bypassing LiteLLM)"

echo "## Direct backend (ISOLATED, one model loaded at a time):"
for backend in ollama omlx mtplx; do
    display_name="$backend"
    echo ""
    isolate_one "$backend"
    echo ""
    echo "Testing ${display_name} directly..."
    run_streaming "$display_name (direct)" "${DIRECT_URLS[$backend]}" "${DIRECT_MODELS[$backend]}"
done

echo >> "$OUTFILE"
write_table_header "Isolated local runs (via LiteLLM)"

echo ""
echo "## Through LiteLLM proxy (ISOLATED, one model loaded at a time):"
for backend in ollama omlx mtplx; do
    display_name="$backend"
    echo ""
    isolate_one "$backend"
    # Ensure litellm proxy is still running
    if ! curl -s -m 2 http://localhost:4000/v1/models > /dev/null 2>&1; then
        launchctl load -w ~/Library/LaunchAgents/local.litellm.proxy.plist 2>/dev/null || true
        sleep 2
    fi
    echo ""
    echo "Testing ${display_name} via LiteLLM..."
    run_streaming "$display_name (litellm)" "$LITELLM_URL" "${LITELLM_MODELS[$backend]}" "$LITELLM_API_KEY"
done

# --- OpenRouter (cloud, always live) ---
echo >> "$OUTFILE"
write_table_header "OpenRouter (cloud, direct + LiteLLM)"

echo ""
echo "## OpenRouter (cloud, always live):"
# Restore all local services so system is back to normal
echo ""
echo "  [cleanup] restoring all local services..."
"$(cd "$(dirname "$0")/../bin" && pwd)/llm-restore-providers"

echo ""
echo "Testing OpenRouter models (direct + via LiteLLM)..."
for slug in "${OPENROUTER_MODELS[@]}"; do
    short="${slug#qwen/}"
    if [ -n "$OPENROUTER_API_KEY" ]; then
        run_streaming "openrouter $short (direct)" "$OPENROUTER_DIRECT_URL" "$slug" "$OPENROUTER_API_KEY"
    else
        echo "  openrouter $short (direct): SKIPPED (no OpenRouter API key found)"
        echo "| openrouter $short (direct) | N/A | N/A | N/A | N/A |" >> "$OUTFILE"
    fi
    run_streaming "openrouter $short (litellm)" "$LITELLM_URL" "openrouter/$slug" "$LITELLM_API_KEY"
done

{
    echo
    echo
    echo "## Notes"
    echo
    echo "- **Local backends are run in isolation**: before each test, all local models are unloaded from RAM."
    echo "  - **Ollama**: \`ollama stop qwen3.8:27b-mlx\` — daemon keeps :11434 bound but no model in GPU/RAM"
    echo "  - **oMLX**: \`omlx stop\` — service halts entirely"
    echo "  - **MTPLX**: \`mtplx stop --port 8003 --grace-seconds 10\` — backgrounded serve process halts"
    echo "- **OpenRouter** is cloud-only; no local service management needed. Each of the four models is tested both directly against the OpenRouter API and via LiteLLM."
    echo "- All backends use the **same prompt** with \`temperature=0.0\`."
    echo "- \`throughput\` excludes TTFT (prefill) — it's generation-only."
    echo "- Run multiple times and average to reduce variance from cold caches."
    echo
    echo "Results saved to: $OUTFILE"
} >> "$OUTFILE"

echo ""
echo ""
echo "Results saved to: $OUTFILE"
echo "All local services restored to running state."
