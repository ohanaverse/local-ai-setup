#!/opt/homebrew/bin/bash
# qwen3.8-benchmark-multi — Run qwen3.8-benchmark N times and aggregate results
#
# Usage:
#   qwen3.8-benchmark-multi 3          # 3 passes (default)
#   qwen3.8-benchmark-multi 5 200      # 5 passes, 200 max_tokens each
#
# Each pass writes a separate markdown file. This script does not aggregate
# automatically — it just runs N passes with cool-down between them. Use a
# markdown viewer or `grep` to compare files.
#
# Cool-down between passes is 15s to let the machine cool slightly.

set -e

PASSES="${1:-3}"
MAX_TOKENS="${2:-200}"
COOLDOWN="${3:-15}"

echo "Running $PASSES passes with max_tokens=$MAX_TOKENS, ${COOLDOWN}s cool-down between passes"
echo

for i in $(seq 1 "$PASSES"); do
    echo "===== Pass $i / $PASSES ====="
    "$(dirname "$0")/qwen3.8-benchmark" "$MAX_TOKENS"
    echo
    if [ "$i" -lt "$PASSES" ]; then
        echo "Cooling down for ${COOLDOWN}s..."
        sleep "$COOLDOWN"
    fi
done

echo
echo "===== All $PASSES passes complete ====="
echo "Latest result: $(ls -t /tmp/qwen3.8-benchmark-*.md | head -1)"
echo "All results:"
ls -lt /tmp/qwen3.8-benchmark-*.md | head -"$PASSES"
