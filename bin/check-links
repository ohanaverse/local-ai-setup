#!/usr/bin/env python3
"""Check repo-relative markdown links across all tracked markdown.

Targets are derived from `git ls-files` so every tree added to the monorepo
is covered automatically — a hardcoded directory list drifted stale the
moment new subtrees landed.

Historical superpowers plans/specs are excluded: they are point-in-time
design records whose links describe the state of the world when written.
"""
import re
import pathlib
import subprocess
import sys
import urllib.parse

EXCLUDED_PARTS = {"superpowers", ".venv"}

ls_files = subprocess.run(
    ["git", "ls-files", "*.md"],
    capture_output=True,
    text=True,
    check=True,
)
TARGETS = [
    pathlib.Path(line)
    for line in ls_files.stdout.splitlines()
    if not any(part in EXCLUDED_PARTS for part in pathlib.Path(line).parts)
]

broken = []
for p in TARGETS:
    text = p.read_text()
    for m in re.finditer(r"]\(([^)#\s]+)(?:#[^)]*)?\)", text):
        target = urllib.parse.unquote(m.group(1))
        if target.startswith(("http", "mailto")):
            continue
        if not (p.parent / target).exists():
            broken.append(f"{p}: {target}")

if broken:
    print("\n".join(broken))
    sys.exit(1)
print("ALL LINKS OK")
