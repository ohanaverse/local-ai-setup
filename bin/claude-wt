#!/usr/bin/env bash
# claude-wt — launch Claude Code in a chosen worktree or branch.
# Usage: claude-wt [-w/--worktree <name>] [--cwd] [--yolo] [--code] [--design] [--native] [claude-args...]
#
# Install: copy to ~/.local/bin/claude-wt alongside wt-core.sh.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Bootstrap guard: wt-core.sh must be co-located
if [[ ! -f "$SCRIPT_DIR/wt-core.sh" ]]; then
  printf '%s: wt-core.sh not found at %s/wt-core.sh\n' "$(basename "$0")" "$SCRIPT_DIR" >&2
  printf '%s: Ensure both wt-core.sh and %s are copied to the same directory.\n' "$(basename "$0")" "$(basename "$0")" >&2
  exit 1
fi

# Model rotation defaults for claude — must be set before sourcing wt-core.sh.
WT_DEFAULT_CODE="native:claude"
WT_DEFAULT_DESIGN="native:claude"
WT_AGENT_NAME="claude"

source "$SCRIPT_DIR/wt-core.sh"

WT_NAME="$(basename "$0")"

wt_check_deps() {
  command -v claude >/dev/null 2>&1 || die "claude not found. Install: curl -fsSL https://claude.ai/install.sh | bash"
}

wt_yolo_flag() {
  echo "--dangerously-skip-permissions"
}

# Config helper: read PROVIDER_OLLAMA_BASE_URL from models.conf.
# Falls back to localhost:11434. Trailing /v1 is stripped and re-added.
_ollama_base_url() {
  local base="http://localhost:11434"
  if [[ -f "$(wt_config_dir)/models.conf" ]]; then
    local configured
    configured=$(source "$(wt_config_dir)/models.conf" && printf '%s' "${PROVIDER_OLLAMA_BASE_URL:-}")
    [[ -n "$configured" ]] && base="$configured"
  fi
  printf '%s' "${base%/v1}"
}

wt_exec() {
  local model_to_use=""

  # --native flag: use agent's native model, error if not configured.
  if [[ "${WT_NATIVE:-0}" -eq 1 ]]; then
    local config_file="$(wt_config_dir)/models.conf"
    if [[ -f "$config_file" ]]; then
      source "$config_file"
      if [[ -n "${NATIVE_CLAUDE:-}" ]]; then
        model_to_use="$NATIVE_CLAUDE"
      else
        die "--native requires NATIVE_CLAUDE to be configured in models.conf"
      fi
    else
      die "--native requires models.conf with NATIVE_CLAUDE configured"
    fi
  elif [[ -n "${WT_MODEL_MODE:-}" ]]; then
    # Only wt_exec rotates — wt_pre_exec does not call get_model_from_rotation().
    # This prevents double-rotation when resuming a session (wt_pre_exec execs
    # with --resume; wt_exec handles all other launches).
    model_to_use=$(get_model_from_rotation) || exit 1
  fi

  # Launch claude with selected model.
  if [[ -n "$model_to_use" ]]; then
    if [[ "$model_to_use" == native:* && "$model_to_use" != "native:claude" ]]; then
      printf '%s: skipping "%s" (not a claude model)\n' "$WT_NAME" "$model_to_use" >&2
      exec claude "$@"
    fi
    if [[ "$model_to_use" == "native" || "$model_to_use" == "native:claude" ]]; then
      exec claude "$@"
    fi
    # Cloud model — set Ollama env vars for Anthropic-compatible API.
    exec env \
      ANTHROPIC_AUTH_TOKEN=ollama \
      ANTHROPIC_API_KEY="" \
      ANTHROPIC_BASE_URL="$(_ollama_base_url)" \
      claude --model "$model_to_use" "$@"
  fi
  exec claude "$@"
}

# Session resume hook: detects ~/.claude/projects/<slug>/*.jsonl sessions.
# Skips prompt when WT_CWD=1 (--cwd flag).
# IMPORTANT: Does NOT call get_model_from_rotation(). Rotation happens only in
# wt_exec, which handles all non-resume launches. This function only runs when
# a prior session exists and the user chooses to resume — the session already
# carries its model context, so we pass only --native if explicitly set.
wt_pre_exec() {
  local path="$1"
  shift

  # Skip session resume prompt when --cwd is used.
  [[ "${WT_CWD:-0}" -eq 1 ]] && return

  # Skip session resume when a model mode is explicitly requested.
  # Resuming would bypass the intended model selection (--code, --design, --native).
  [[ -n "${WT_MODEL_MODE:-}" || "${WT_NATIVE:-0}" -eq 1 ]] && return

  local session_info
  session_info="$(find_latest_session "$path")"
  if [[ -z "$session_info" ]]; then
    return
  fi

  local session_id mtime branch choice
  IFS=$'\t' read -r session_id mtime <<<"$session_info"
  branch="$(git branch --show-current 2>/dev/null || basename "$path")"
  choice="$(session_resume_prompt "$branch" "$session_id" "$mtime")"
  [[ -z "$choice" ]] && return

  # --native flag: read NATIVE_CLAUDE directly.
  # Do NOT call get_model_from_rotation() — rotation is handled by wt_exec only.
  local model_to_use=""
  if [[ "${WT_NATIVE:-0}" -eq 1 ]]; then
    local config_file="$(wt_config_dir)/models.conf"
    if [[ -f "$config_file" ]]; then
      source "$config_file"
      if [[ -n "${NATIVE_CLAUDE:-}" ]]; then
        model_to_use="$NATIVE_CLAUDE"
      else
        die "--native requires NATIVE_CLAUDE to be configured in models.conf"
      fi
    else
      die "--native requires models.conf with NATIVE_CLAUDE configured"
    fi
  fi

  local model_args=()
  if [[ -n "$model_to_use" ]]; then
    if [[ "$model_to_use" == native:* && "$model_to_use" != "native:claude" ]]; then
      printf '%s: skipping "%s" (not a claude model)\n' "$WT_NAME" "$model_to_use" >&2
    elif [[ "$model_to_use" != "native" && "$model_to_use" != "native:claude" ]]; then
      model_args=("--model" "$model_to_use")
    fi
  fi

  # Set Ollama env vars for cloud models.
  if [[ ${#model_args[@]} -gt 0 ]]; then
    exec env \
      ANTHROPIC_AUTH_TOKEN=ollama \
      ANTHROPIC_API_KEY="" \
      ANTHROPIC_BASE_URL="$(_ollama_base_url)" \
      claude --resume "$choice" "${model_args[@]}" "$@"
  fi
  exec claude --resume "$choice" "$@"
}

wt_main "$@"
