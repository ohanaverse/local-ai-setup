#!/usr/bin/env bash
# codex-wt — launch OpenAI Codex in a chosen worktree or branch.
# Usage: codex-wt [-w/--worktree <name>] [--cwd] [--yolo] [--code] [--design] [--native] [codex-args...]
#
# Install: copy to ~/.local/bin/codex-wt alongside wt-core.sh.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -f "$SCRIPT_DIR/wt-core.sh" ]]; then
  printf '%s: wt-core.sh not found at %s/wt-core.sh\n' "$(basename "$0")" "$SCRIPT_DIR" >&2
  printf '%s: Ensure both wt-core.sh and %s are copied to the same directory.\n' "$(basename "$0")" "$(basename "$0")" >&2
  exit 1
fi

# Model rotation defaults for codex — must be set before sourcing wt-core.sh.
WT_DEFAULT_CODE="native:codex"
WT_DEFAULT_DESIGN="native:codex"
WT_AGENT_NAME="codex"

source "$SCRIPT_DIR/wt-core.sh"

WT_NAME="$(basename "$0")"

wt_check_deps() {
  command -v codex >/dev/null 2>&1 || die "codex not found. Install: npm install -g @openai/codex"
}

wt_yolo_flag() {
  echo "--dangerously-bypass-approvals-and-sandbox"
}

# Config helper: read PROVIDER_OLLAMA_BASE_URL from models.conf.
# Falls back to http://localhost:11434. Trailing slashes and any /v1 suffix
# are stripped so the profile always has a single canonical /v1.
_ollama_base_url() {
  local base="http://localhost:11434"
  if [[ -f "$(wt_config_dir)/models.conf" ]]; then
    local configured
    configured=$(source "$(wt_config_dir)/models.conf" && printf '%s' "${PROVIDER_OLLAMA_BASE_URL:-}")
    [[ -n "$configured" ]] && base="$configured"
  fi
  base="${base%/}"
  base="${base%/v1}"
  printf '%s/v1\n' "$base"
}

# Auto-migrate a legacy [profiles.ollama-launch] block from config.toml to
# a separate profile file. Codex >=0.134.0 requires profiles in their own
# files; this only runs the first time it is needed.
_migrate_legacy_ollama_profile() {
  local config="$HOME/.codex/config.toml"
  local profile="$HOME/.codex/ollama-launch.config.toml"

  [[ -f "$config" ]] || return 0
  grep -q '^\[profiles\.ollama-launch\]' "$config" || return 0
  [[ -f "$profile" ]] && return 0

  local section_lines
  section_lines="$(awk '
    BEGIN { found=0 }
    /^\[profiles\.ollama-launch\]/ { found=1; next }
    found && /^\[/                { exit }
    found && NF                   { print }
  ' "$config")"

  [[ -z "$section_lines" ]] && return 0

  printf '%s\n' "$section_lines" >"$profile"

  local tmp="${config}.tmp.$$"
  awk '
    /^\[profiles\.ollama-launch\]/ { skip=1; next }
    skip && /^\[/                    { skip=0 }
    !skip                            { print }
  ' "$config" >"$tmp" && mv "$tmp" "$config"

  printf '%s: migrated [profiles.ollama-launch] from config.toml to %s\n' \
    "$WT_NAME" "$profile" >&2
}

# Idempotently write ~/.codex/ollama-launch.config.toml with a correct shape.
# The profile needs both a top-level `model` and `model_provider` setting —
# without those, codex falls back to its default provider (openai), which
# shows a login prompt when no auth is configured.
#
# Always overwrites: a malformed profile (model_provider nested inside the
# provider table, missing model line, etc.) silently sends traffic to
# api.openai.com and 401s. Writing a known-good profile is safer than
# trying to surgically repair unknown shapes.
#
# Args: $1 = model name to embed in the profile.
_ensure_ollama_profile() {
  local model="$1"
  local dir="$HOME/.codex"
  local profile="$dir/ollama-launch.config.toml"
  local base_url
  base_url="$(_ollama_base_url)"

  mkdir -p "$dir"

  _migrate_legacy_ollama_profile

  local tmp="${profile}.tmp.$$"
  cat >"$tmp" <<EOF
model = "$model"
model_provider = "ollama-launch"

[model_providers.ollama-launch]
name = "Ollama"
base_url = "$base_url"
wire_api = "responses"
EOF

  if [[ -f "$profile" ]] && cmp -s "$tmp" "$profile"; then
    rm -f "$tmp"
    return 0
  fi

  mv "$tmp" "$profile"
  printf '%s: wrote Ollama profile (model=%s, base_url=%s)\n' \
    "$WT_NAME" "$model" "$base_url" >&2
}

wt_exec() {
  local model_to_use=""

  if [[ "${WT_NATIVE:-0}" -eq 1 ]]; then
    local config_file="$(wt_config_dir)/models.conf"
    if [[ -f "$config_file" ]]; then
      source "$config_file"
      if [[ -n "${NATIVE_CODEX:-}" ]]; then
        model_to_use="$NATIVE_CODEX"
      else
        die "--native requires NATIVE_CODEX to be configured in models.conf"
      fi
    else
      die "--native requires models.conf with NATIVE_CODEX configured"
    fi
  elif [[ -n "${WT_MODEL_MODE:-}" ]]; then
    model_to_use=$(get_model_from_rotation) || exit 1
  fi

  if [[ -n "$model_to_use" ]]; then
    if [[ "$model_to_use" == native:* && "$model_to_use" != "native:codex" ]]; then
      printf '%s: skipping "%s" (not a codex model)\n' "$WT_NAME" "$model_to_use" >&2
      exec codex "$@"
    fi
    if [[ "$model_to_use" == "native" || "$model_to_use" == "native:codex" ]]; then
      exec codex "$@"
    fi
    _ensure_ollama_profile "$model_to_use"
    exec codex --profile ollama-launch -m "$model_to_use" "$@"
  fi
  exec codex "$@"
}

wt_main "$@"
