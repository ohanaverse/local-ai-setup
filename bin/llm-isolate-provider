#!/bin/bash
# llm-isolate-provider — stop other local providers, start+warmup one.
# Usage: llm-isolate-provider <provider-id>
#        llm-isolate-provider stop-all   (stop every local provider; modelman stop)
# Supported: ollama, omlx, omlx-6bit, mlx_lm_server, mtplx
# (The llamacpp case branch below is retained but disabled — retired
# 2026-09-07, issue #33. Re-enable steps: docs/reference/provider-artifacts.md.)
# On success, print JSON with provider/model/direct_url.

set -e

# shellcheck source=lib/poll.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/poll.sh"
# lib/mlx-lm-resolve.sh is not sourced here: this script no longer resolves
# mlx_lm.* binaries itself — mlx-lm-server.sh (sourced below) does that, and
# sources the resolver for its own scope.
# shellcheck source=lib/mlx-lm-server.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/mlx-lm-server.sh"

PROVIDER="$1"
if [ -z "$PROVIDER" ]; then
    echo "usage: llm-isolate-provider <provider-id>" >&2
    exit 1
fi

# Default model names / URLs. Override via env for non-standard setups.
OLLAMA_MODEL="${LLM_ISOLATE_OLLAMA_MODEL:-ornith-1.5:35b}"
LLAMACPP_MODEL="${LLM_ISOLATE_LLAMACPP_MODEL:-local-llama}"
OMLX_4BIT_MODEL="${LLM_ISOLATE_OMLX_4BIT_MODEL:-Ornith-1.5-35B-A3B-MLX-4bit}"
OMLX_6BIT_MODEL="${LLM_ISOLATE_OMLX_6BIT_MODEL:-Ornith-1.5-35B-A3B-MLX-6bit}"
# No default pairing exists in this repo for mlx_lm_server (unlike the
# providers above) — these env vars are a fallback for callers that don't
# pass positional args, not a baked-in default model that may not even be
# downloaded.
MLXLM_MODEL="${LLM_ISOLATE_MLXLM_MODEL:-}"
MLXLM_DRAFT_MODEL="${LLM_ISOLATE_MLXLM_DRAFT_MODEL:-}"

warmup_payload() {
    local model="$1"
    python3 - "$model" <<'PYEOF'
import json, sys
m = sys.argv[1]
print(json.dumps({"model": m, "messages": [{"role": "user", "content": "hi"}], "max_tokens": 1, "temperature": 0, "stream": False}))
PYEOF
}

# Stop every provider except the one being isolated so the target has the
# GPU/RAM to itself. Skipping the target avoids an unload+reload cycle.
# After each stop, poll (bounded) until the provider actually lets go instead
# of sleeping a fixed 3s. Timeouts warn but are not fatal — a stuck stop must
# not abort the whole isolation (the pre-poll `sleep 3` never did).
#
# The providers being stopped are independent processes/ports, so each
# stop+poll pair is backgrounded and waited on together — isolating costs the
# slowest stop rather than their sum (same pattern as llm-restore-providers'
# parallel restart). Only the "all non-target providers stopped before this
# function returns" guarantee matters to callers, not the order among them.
stop_all_local() {
    local keep="$1"
    local pids=()

    if [ "$keep" != "ollama" ]; then
        (
            # Stop every model ollama actually has loaded, not a baked-in
            # default: `modelman start`/`modelman stop` may have loaded any
            # model, and stopping $OLLAMA_MODEL while another one holds the
            # GPU would leave two models resident (the exact condition this
            # isolation exists to prevent). `ollama ps` lists loaded models
            # only; a down daemon lists nothing, which is already "stopped".
            while IFS= read -r loaded; do
                [ -n "$loaded" ] || continue
                silence_stdout ollama stop "$loaded" || true
            done < <(ollama ps 2>/dev/null | tail -n +2 | awk 'NF {print $1}')
            # `ollama stop` unloads the model but keeps the daemon (port
            # 11434) up, so poll `ollama ps` for an empty model list, not
            # the port.
            wait_for_ollama_unloaded 5 \
                || echo "warning: ollama still has models loaded" >&2
        ) &
        pids+=("$!")
    fi
    if [ "$keep" != "omlx" ]; then
        (
            silence_stdout omlx stop || true
            wait_for_port_closed http://localhost:8000/v1/models 5 \
                || echo "warning: omlx still listening on port 8000" >&2
        ) &
        pids+=("$!")
    fi
    if [ "$keep" != "llamacpp" ] && [ -f ~/Library/LaunchAgents/local.llamacpp.server.plist ]; then
        (
            launchctl unload ~/Library/LaunchAgents/local.llamacpp.server.plist 2>/dev/null || true
            wait_for_port_closed http://localhost:8080/v1/models 5 \
                || echo "warning: llama.cpp still listening on port 8080" >&2
        ) &
        pids+=("$!")
    fi
    if [ "$keep" != "mlx_lm_server" ]; then
        (
            mlx_lm_server_stop
            wait_for_port_closed http://localhost:8001/v1/models 5 \
                || echo "warning: mlx_lm_server still listening on port 8001" >&2
        ) &
        pids+=("$!")
    fi
    if [ "$keep" != "mtplx" ]; then
        (
            silence_stdout mtplx stop --port 8003 --grace-seconds 10 || true
            wait_for_port_closed http://localhost:8003/v1/models 5 \
                || echo "warning: mtplx still listening on port 8003" >&2
        ) &
        pids+=("$!")
    fi

    local pid
    for pid in "${pids[@]}"; do
        wait "$pid"
    done
}

# Poll until `ollama ps` lists no loaded models (model unload ≈ GPU/RAM freed).
wait_for_ollama_unloaded() {
    local tries="${1:-5}"
    local i
    for ((i = 0; i < tries; i++)); do
        if [ -z "$(ollama ps 2>/dev/null | tail -n +2)" ]; then
            return 0
        fi
        sleep 0.2
    done
    return 1
}

# Warm up a model on a running server, retrying until it answers or we give up.
# The liveness check and the warmup are separate: the server can be up while
# the model is still loading into GPU/RAM.
warmup() {
    local url="$1" model="$2" health_url="$3"
    local payload resp
    payload=$(warmup_payload "$model")
    for _ in {1..90}; do
        if curl -s -m 2 "$health_url" >/dev/null 2>&1; then
            resp=$(curl -s -m 120 "$url" \
                -H "Content-Type: application/json" -d "$payload" 2>/dev/null || true)
            if echo "$resp" | grep -q '"object":"chat.completion"'; then
                return 0
            fi
        fi
        sleep 1
    done
    return 1
}

# Warm up a provider's model, exiting with a clear error on failure.
warmup_or_die() {
    local name="$1" model="$2" url="$3" health_url="$4"
    if warmup "$url" "$model" "$health_url"; then
        return 0
    fi
    echo "failed to warm up $name model $model at $url" >&2
    exit 1
}

start_ollama() {
    if ! curl -s -m 2 http://localhost:11434/api/tags >/dev/null 2>&1; then
        launchctl kickstart -k "gui/$(id -u)/com.ollama.ollama" 2>/dev/null || true
    fi
    warmup_or_die ollama "$OLLAMA_MODEL" http://localhost:11434/v1/chat/completions http://localhost:11434/api/tags
}

start_llamacpp() {
    if [ ! -f ~/Library/LaunchAgents/local.llamacpp.server.plist ]; then
        echo "llamacpp service not configured: ~/Library/LaunchAgents/local.llamacpp.server.plist missing" >&2
        exit 1
    fi
    launchctl load -w ~/Library/LaunchAgents/local.llamacpp.server.plist 2>/dev/null || true
    warmup_or_die llamacpp "$LLAMACPP_MODEL" http://localhost:8080/v1/chat/completions http://localhost:8080/v1/models
}

start_omlx() {
    local model="$1"
    if ! command -v omlx >/dev/null 2>&1; then
        echo "omlx binary not found on PATH" >&2
        exit 1
    fi
    omlx start >/dev/null 2>&1 || true
    warmup_or_die omlx "$model" http://localhost:8000/v1/chat/completions http://localhost:8000/v1/models
}

start_mlx_lm_server() {
    local target="$1" draft="$2"
    # No binary resolve here: mlx_lm_server_start resolves mlx_lm.server
    # itself (the single source of truth) and returns 1 when it can't,
    # which the line below surfaces as exit 1.
    mlx_lm_server_start "$target" "$draft" 8001 || exit 1
    warmup_or_die mlx_lm_server "$target" http://localhost:8001/v1/chat/completions http://localhost:8001/v1/models
}

case "$PROVIDER" in
    stop-all)
        # Tear down every local provider with no target kept running —
        # `modelman stop`'s delegate. stop_all_local's "keep" arg is
        # compared with `!=` against each provider name, so an empty
        # string never matches any of them and every branch runs.
        stop_all_local ""
        python3 - <<'PYEOF'
import json
print(json.dumps({"provider": None, "model": None, "direct_url": None, "ok": True, "error": None}))
PYEOF
        exit 0
        ;;
    ollama)
        stop_all_local ollama
        start_ollama
        model="$OLLAMA_MODEL"
        direct_url="http://localhost:11434/v1/chat/completions"
        ;;
    llamacpp)
        stop_all_local llamacpp
        start_llamacpp
        model="$LLAMACPP_MODEL"
        direct_url="http://localhost:8080/v1/chat/completions"
        ;;
    omlx)
        stop_all_local omlx
        start_omlx "$OMLX_4BIT_MODEL"
        model="$OMLX_4BIT_MODEL"
        direct_url="http://localhost:8000/v1/chat/completions"
        ;;
    omlx-6bit)
        stop_all_local omlx
        start_omlx "$OMLX_6BIT_MODEL"
        model="$OMLX_6BIT_MODEL"
        direct_url="http://localhost:8000/v1/chat/completions"
        ;;
    mlx_lm_server)
        stop_all_local mlx_lm_server
        target="${2:-$MLXLM_MODEL}"
        draft="${3:-$MLXLM_DRAFT_MODEL}"
        if [ -z "$target" ] || [ -z "$draft" ]; then
            echo "mlx_lm_server requires target+draft: pass as positional args or set LLM_ISOLATE_MLXLM_MODEL/LLM_ISOLATE_MLXLM_DRAFT_MODEL" >&2
            exit 1
        fi
        start_mlx_lm_server "$target" "$draft"
        model="$target (+draft $draft)"
        direct_url="http://localhost:8001/v1/chat/completions"
        ;;
    mtplx)
        # MTPLX start/stop/warmup lives in the Python lifecycle module; the
        # shim delegates entirely and passes the module's JSON through.
        # Forward an explicit model arg so callers (modelman start, benchmark
        # sweeps) can select a specific mtplx model instead of defaulting to
        # the first one in the registry.
        if [ -n "${2:-}" ]; then
            python3 -m modelman.providers.lifecycle isolate mtplx "$2"
        else
            python3 -m modelman.providers.lifecycle isolate mtplx
        fi
        exit $?
        ;;
    *)
        echo "unknown provider: $PROVIDER" >&2
        exit 1
        ;;
esac

# Build the JSON envelope. Args are well-defined strings (no shell quoting
# concerns), so one Python call handles the encoding.
python3 - "$PROVIDER" "$model" "$direct_url" <<'PYEOF'
import json, sys
print(json.dumps({
    "provider": sys.argv[1],
    "model": sys.argv[2],
    "direct_url": sys.argv[3],
    "ok": True,
    "error": None,
}))
PYEOF
