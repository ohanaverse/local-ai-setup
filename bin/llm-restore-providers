#!/bin/bash
# llm-restore-providers — bring all local providers back up after a benchmark.

set -e

LOG_PREFIX="[llm-restore-providers]"

# shellcheck source=lib/poll.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/poll.sh"
# shellcheck source=lib/mlx-lm-server.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/mlx-lm-server.sh"

# Wait up to N seconds for a service to answer on its health URL.
wait_for() {
    local url="$1" name="$2" tries="${3:-30}"
    if poll_until_up "$url" 1 "$tries"; then
        return 0
    fi
    echo "$LOG_PREFIX $name did not come back up ($url)" >&2
    return 1
}

restart_ollama() {
    curl -s -m 2 http://localhost:11434/api/tags >/dev/null 2>&1 && return 0
    echo "$LOG_PREFIX restarting ollama..."
    launchctl kickstart -k "gui/$(id -u)/com.ollama.ollama" 2>/dev/null || true
    wait_for http://localhost:11434/api/tags ollama
}

restart_omlx() {
    curl -s -m 2 http://localhost:8000/v1/models >/dev/null 2>&1 && return 0
    echo "$LOG_PREFIX restarting omlx..."
    omlx start >/dev/null 2>&1 || true
    wait_for http://localhost:8000/v1/models omlx
}

# Restart a launchd-managed service (llama.cpp / LiteLLM proxy).
restart_launchd() {
    local plist="$1" url="$2" name="$3"
    curl -s -m 2 "$url" >/dev/null 2>&1 && return 0
    if [ ! -f "$plist" ]; then
        echo "$LOG_PREFIX $name not configured ($plist missing); skipping" >&2
        return 0
    fi
    echo "$LOG_PREFIX restarting $name..."
    launchctl load -w "$plist" 2>/dev/null || true
    wait_for "$url" "$name"
}

stop_mtplx() {
    silence_stdout mtplx stop --port 8003 --grace-seconds 10 || true
    wait_for_port_closed http://localhost:8003/v1/models 5 \
        || echo "warning: mtplx still listening on port 8003" >&2
}

# Restart all providers in parallel — they are independent, so wall time is
# the slowest service, not the sum.
#
# mlx_lm_server and mtplx are never part of the standing baseline (unlike
# ollama/omlx/litellm, which are always-on services this script restores), so
# their entries here are *stops*, not restarts. They must run unconditionally on
# every invocation: `modelman benchmark` calls isolate_provider() per-target but
# restore_providers() only once at the very end of a run, so if the last
# isolated target was one of them, this is the only place its subprocess gets
# torn down — otherwise it would keep running (holding GPU/RAM) right alongside
# the providers restored below, defeating the point of isolation.
FAILED=0
restart_ollama & p1=$!
restart_omlx & p2=$!
# llamacpp retired 2026-09-07 (issue #33) — not restarted; re-enable steps
# in docs/reference/provider-artifacts.md.
restart_launchd ~/Library/LaunchAgents/local.litellm.proxy.plist http://localhost:4000/v1/models litellm & p3=$!
mlx_lm_server_stop & p4=$!
stop_mtplx & p5=$!
wait $p1 || FAILED=1
wait $p2 || FAILED=1
wait $p3 || FAILED=1
wait $p4 || FAILED=1
wait $p5 || FAILED=1

if [ "$FAILED" -ne 0 ]; then
    echo "$LOG_PREFIX one or more providers failed to restore" >&2
    exit 1
fi
echo "$LOG_PREFIX providers restored"
