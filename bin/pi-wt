#!/usr/bin/env bash
# pi-wt — launch Pi coding agent in a chosen worktree or branch.
# Usage: pi-wt [-w/--worktree <name>] [--cwd] [--yolo] [--code] [--design] [--native] [pi-args...]
#
# Install: copy to ~/.local/bin/pi-wt alongside wt-core.sh.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -f "$SCRIPT_DIR/wt-core.sh" ]]; then
  printf '%s: wt-core.sh not found at %s/wt-core.sh\n' "$(basename "$0")" "$SCRIPT_DIR" >&2
  printf '%s: Ensure both wt-core.sh and %s are copied to the same directory.\n' "$(basename "$0")" "$(basename "$0")" >&2
  exit 1
fi

# Model rotation defaults for pi — must be set before sourcing wt-core.sh.
WT_DEFAULT_CODE="claude-sonnet-4-6"
WT_DEFAULT_DESIGN="claude-sonnet-4-6"
WT_AGENT_NAME="pi"

source "$SCRIPT_DIR/wt-core.sh"

WT_NAME="$(basename "$0")"

wt_check_deps() {
  command -v pi >/dev/null 2>&1 || die "pi not found. Install: npm install -g @mariozechner/pi-coding-agent"
}

wt_yolo_flag() {
  # Pi has no documented permission-bypass flag.
  echo ""
}

pi_launcher() {
  if [[ -x "$HOME/.pi/agent/activate-litellm.sh" ]]; then
    printf '%s\n' "$HOME/.pi/agent/activate-litellm.sh"
  else
    printf 'pi\n'
  fi
}

# Syncs models.conf non-native models (cloud + local) into ~/.pi/agent/models.json if missing.
# Idempotent — safe to run on every launch. Only adds, never removes.
_sync_pi_models() {
  local config_file="$(wt_config_dir)/models.conf"
  local pi_models="$HOME/.pi/agent/models.json"

  [[ -f "$config_file" ]] || return 0
  [[ -f "$pi_models" ]] || return 0

  source "$config_file"

  # Collect all non-native models from both rotation lists.
  # Both cloud (:cloud suffix) and local (MLX, etc.) models need to be
  # in pi's models.json for the jq _launch check to pass.
  local all_models=()
  local m
  for m in "${CODE_MODELS[@]:-}" "${DESIGN_MODELS[@]:-}"; do
    [[ -z "$m" ]] && continue
    [[ "$m" == native:* ]] && continue
    all_models+=("$m")
  done

  [[ ${#all_models[@]} -eq 0 ]] && return 0

  # Read existing model IDs from pi's models.json.
  local existing_ids
  existing_ids=$(jq -r '.providers.ollama.models[].id' "$pi_models" 2>/dev/null || echo "")

  # Build a set of models to add.
  local to_add=()
  for m in "${all_models[@]}"; do
    if ! printf '%s\n' "$existing_ids" | grep -qFx "$m"; then
      to_add+=("$m")
    fi
  done

  [[ ${#to_add[@]} -eq 0 ]] && return 0

  # Add missing models to pi's models.json.
  # Each model gets a minimal config with large context window and text+image input.
  local tmp="$pi_models.tmp.$$"
  local added=0

  # Start with the original file.
  cp "$pi_models" "$tmp" || return 0

  for m in "${to_add[@]}"; do
    # Insert the new model into the models array.
    # Using jq to append to the array.
    if jq --arg model "$m" '
      .providers.ollama.models += [{
        "_launch": true,
        "contextWindow": 262144,
        "id": $model,
        "input": ["text", "image"],
        "reasoning": true
      }]
    ' "$tmp" >"$tmp.new" 2>/dev/null; then
      mv "$tmp.new" "$tmp"
      added=$((added + 1))
    else
      printf '%s: failed to add model %s to pi models.json\n' "$WT_NAME" "$m" >&2
      rm -f "$tmp.new"
    fi
  done

  if [[ $added -gt 0 ]]; then
    mv "$tmp" "$pi_models"
    printf '%s: synced %d model(s) to pi models.json\n' "$WT_NAME" "$added" >&2
  else
    rm -f "$tmp"
  fi
}

wt_exec() {
  # Sync models before attempting to use them.
  _sync_pi_models

  local model_to_use=""

  if [[ "${WT_NATIVE:-0}" -eq 1 ]]; then
    local config_file="$(wt_config_dir)/models.conf"
    if [[ -f "$config_file" ]]; then
      source "$config_file"
      if [[ -n "${NATIVE_PI:-}" ]]; then
        model_to_use="$NATIVE_PI"
      else
        die "--native requires NATIVE_PI to be configured in models.conf"
      fi
    else
      die "--native requires models.conf with NATIVE_PI configured"
    fi
  elif [[ -n "${WT_MODEL_MODE:-}" ]]; then
    model_to_use=$(get_model_from_rotation) || exit 1
  fi

  if [[ -n "$model_to_use" ]]; then
    if [[ "$model_to_use" == native:* && "$model_to_use" != "native:pi" ]]; then
      printf '%s: skipping "%s" (not a pi model)\n' "$WT_NAME" "$model_to_use" >&2
      exec "$(pi_launcher)" "$@"
    fi
    if [[ "$model_to_use" == "native" || "$model_to_use" == "native:pi" ]]; then
      exec "$(pi_launcher)" "$@"
    fi
    # Use jq to verify the model is both present AND marked _launch: true.
    # This prevents launching models that exist in models.json but were
    # added manually (e.g. orphaned entries) and not intended for use.
    if jq -e --arg model "$model_to_use" '
      .providers.ollama.models | any(.id == $model and (._launch // false) == true)
    ' "$HOME/.pi/agent/models.json" >/dev/null 2>&1; then
      exec "$(pi_launcher)" --model "$model_to_use" "$@"
    fi
    printf '%s: model "%s" not configured for pi, using default\n' \
      "$WT_NAME" "$model_to_use" >&2
  fi
  exec "$(pi_launcher)" "$@"
}

wt_main "$@"
