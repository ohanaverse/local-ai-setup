#!/bin/bash
# update/sushi — update the sushi binary (the engine wt serves Qwen3.8-Flash-Next with).
#
# Two installs, two paths, picked by how sushi was installed:
#   - Homebrew (`brew install beamivalice/tap/sushi`, which links the binary
#     into the Cellar): `brew upgrade sushi`. sushi's own `sushi update` would
#     replace the file inside brew's keg behind brew's back, so it is not used.
#   - anything else (a standalone binary): `sushi update`, which replaces the
#     install with the newest GitHub release after checking its SHA-256, its
#     code signature and that it runs, and keeps the old one as
#     <install>.previous.
#
# Neither path may replace sushi under a running server, so a live
# `sushi serve` turns the update into a manual step: `wt stop sushi` first
# (sushi's own --force override is deliberately not used). There is no service
# to restart: wt starts sushi on demand. The packs under ~/.sushi/models are
# not touched. beamivalice/tap is a third-party tap, so a --check refreshes the
# tap first (as update/omlx does).
#
# Usage: update/sushi [--no-network] [--dry-run] [--check]

set -e

# shellcheck source=lib/update-common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/update-common.sh"

update_usage() {
    cat <<'EOF'
usage: update/sushi [--no-network] [--dry-run] [--check]

Report the installed sushi version and whether a newer release exists, and
update it when one does and no `sushi serve` is running: `brew upgrade sushi`
for a Homebrew install, `sushi update` for a standalone one.

  --no-network  skip the release lookup (the status is then manual)
  --dry-run     print the update command instead of running it
  --check       report current, or stale when an update is available; for a
                Homebrew install this runs `brew update` first
EOF
}

update_init sushi "$@"

for arg in "${UPDATE_ARGS[@]}"; do
    case "$arg" in
        --no-network) NO_NETWORK=1 ;;
        *)
            printf 'update/sushi: unknown option %s\n' "$arg" >&2
            exit 2
            ;;
    esac
done

require_cmd sushi

# `sushi --version` prints "sushi 1.4.1" first, then its mlx versions.
sushi_version() {
    sushi --version 2> /dev/null | sed -n 's/^sushi //p' | head -1
}

# sushi's own messages (and a few `[mem]` lines) go to stderr.
sushi_check() {
    sushi update --check 2>&1 | grep -v '^\[mem\]' | sed '/^[[:space:]]*$/d' || true
}

installed=$(sushi_version)
installed=${installed:-unknown}
update_note "installed: $installed"

via=self
if command -v brew > /dev/null 2>&1 && brew list --formula sushi > /dev/null 2>&1; then
    via=brew
fi
update_note "installed via: $via"

if [ -n "${NO_NETWORK:-}" ]; then
    update_finish manual "$installed installed, latest: unknown (--no-network) — rerun without it"
fi

# Is something newer published? Sets `available` (1/0) and `offer` (a words
# line for the trailer).
available=0
offer=""
if [ "$via" = brew ]; then
    dry_run_stop || brew_refresh
    outdated=$(brew_outdated sushi)
    if [ -n "$outdated" ]; then
        available=1
        offer="brew has $outdated"
    fi
else
    # The wording of an out-of-date answer is not known (only "up to date" has
    # been seen), so anything else sushi says is reported as an available
    # update, in its own words, and silence is manual.
    answer=$(sushi_check)
    if [ -z "$answer" ]; then
        update_finish manual "$installed installed, 'sushi update --check' printed nothing — run it by hand"
    fi
    update_note "sushi update --check: $(printf '%s' "$answer" | tail -1)"
    if ! printf '%s\n' "$answer" | grep -qi 'up to date'; then
        available=1
        offer="$(printf '%s' "$answer" | tail -1)"
    fi
fi

if [ "$available" -eq 0 ]; then
    update_finish current "$installed"
fi

# --check changes nothing, so a running server is no obstacle to saying an
# update is available; the refusal below belongs to the update itself.
if [ "$UPDATE_CHECK" -eq 1 ]; then
    update_finish stale "$installed installed; $offer"
fi

# A running server must never be updated underneath.
if pgrep -f 'sushi serve' > /dev/null 2>&1; then
    update_finish manual "$installed installed; $offer, but a sushi server is running — stop it first (\`wt stop sushi\` where wt manages Sushi, otherwise the process itself), then rerun"
fi

if [ "$via" = brew ]; then
    brew_upgrade sushi
else
    run sushi update || update_fail "sushi update failed"
fi
if dry_run_stop; then
    update_finish dry-run "$installed -> newest sushi via $via"
fi

after=$(sushi_version)
after=${after:-unknown}
update_note "installed: $after"
if [ "$via" = brew ]; then
    # Reuses the brew tail: `updated` only when the version moved; a brew
    # revision bump with the same version string reports `current`.
    finish_after_upgrade "$installed" "$after" brew "$(brew_outdated sushi)" ""
fi
if [ "$after" = "unknown" ] || [ "$installed" = "unknown" ]; then
    update_finish manual "sushi update ran, but the version cannot be read (was $installed, now $after) — check 'sushi --version'"
fi
if [ "$after" = "$installed" ]; then
    update_finish failed "sushi update ran but sushi is still $installed"
fi
update_finish updated "$installed -> $after"
