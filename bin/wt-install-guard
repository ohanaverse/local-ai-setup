#!/usr/bin/env bash
# wt-install-guard — install or update the block-main-commit pre-commit hook.
# Run standalone or invoked automatically by *-wt launchers.

set -euo pipefail

PROTECTED="main master"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Installs a pre-commit hook that blocks commits to protected branches.

Options:
  -h, --help           Show this help
  --branches b1,b2     Comma-separated protected branches (default: main,master)
  --check              Only check if guard is installed; exit 0 if yes, 1 if no
  --uninstall          Remove the guard (restores latest backup if found)
EOF
  exit 0
}

die() { printf '%s: %s\n' "$(basename "$0")" "$*" >&2; exit 1; }

git_dir() {
  # Use --git-common-dir so worktrees resolve to the shared git directory
  # where hooks are actually stored.
  git rev-parse --git-common-dir 2>/dev/null || die "not inside a git repository"
}

find_backup() {
  local gdir="$1"
  local latest=""
  for f in "$gdir"/hooks/pre-commit.*.bak; do
    [[ -f "$f" ]] || continue
    [[ "$f" -nt "$latest" ]] && latest="$f"
  done
  printf '%s' "$latest"
}

generate_hook() {
  local protected="$1"
  # Emit a POSIX sh hook that matches the source hook in bin/git-hooks/block-main-commit.
  # The branches are baked in at generation time; no env-var override in the generated hook.
  cat <<EOF
#!/usr/bin/env sh
# block-main-commit v1
# Installed by wt-install-guard
# Protected: $protected

BRANCH="\$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if [ -z "\$BRANCH" ]; then
  cat >&2 <<'INNER_EOF'
[block-main-commit] WARNING: Could not determine current branch (detached HEAD?).
Proceed with caution — you may be committing to a protected branch.
INNER_EOF
fi

# Allow CI/automation to bypass via env var.
if [ -n "\$WT_SKIP_MAIN_BLOCK" ]; then
  exit 0
fi

_old_ifs="\$IFS"
IFS=' '
set -f
for _b in $protected; do
  [ -n "\$_b" ] || continue
  if [ "\$BRANCH" = "\$_b" ]; then
    IFS="\$_old_ifs"
    set +f
    cat >&2 <<'INNER_EOF'
[block-main-commit] Commits to protected branches are blocked.

Work on a feature branch instead:
  git checkout -b my-feature
  git commit -m "..."

Or create a worktree:
  claude-wt --worktree my-feature

To bypass in an emergency: git commit --no-verify
INNER_EOF
    exit 1
  fi
done
IFS="\$_old_ifs"
set +f
EOF
}

is_ours() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  local rc=0
  grep -q "block-main-commit v1" "$path" 2>/dev/null || rc=$?
  if [[ $rc -eq 0 ]]; then
    return 0
  elif [[ $rc -eq 2 ]]; then
    die "cannot read hook file: $path (permission denied?)"
  else
    return 1
  fi
}

is_up_to_date() {
  local path="$1"
  local wanted_protected="$2"
  local installed_protected
  installed_protected="$(grep "^# Protected:" "$path" 2>/dev/null)" || {
    local rc=$?
    [[ $rc -eq 2 ]] && die "cannot read hook file: $path (permission denied?)"
    return 1
  }
  installed_protected="$(printf '%s' "$installed_protected" | sed 's/^# Protected: //')"
  # Trim leading/trailing whitespace for robust comparison.
  installed_protected="${installed_protected#"${installed_protected%%[![:space:]]*}"}"
  installed_protected="${installed_protected%"${installed_protected##*[![:space:]]}"}"
  [[ "$installed_protected" == "$wanted_protected" ]]
}

do_install() {
  local gdir
  gdir="$(git_dir)"
  local hook="$gdir/hooks/pre-commit"

  if is_ours "$hook"; then
    if is_up_to_date "$hook" "$PROTECTED"; then
      echo "Guard already active (v1, branches: $PROTECTED)."
      exit 0
    else
      echo "Guard outdated. Reinstalling..."
      local bak
      bak="$hook.$(date +%Y%m%d).bak"
      cp "$hook" "$bak"
      echo "Backed up old guard to $bak"
      generate_hook "$PROTECTED" > "$hook"
      chmod +x "$hook"
      echo "Guard installed. Protected branches: $PROTECTED"
      exit 0
    fi
  elif [[ -f "$hook" ]]; then
    # Simple script exists. Back it up and chain.
    # Use mktemp to avoid race conditions if multiple installs run concurrently.
    local bak
    bak="$(mktemp "${hook}.$(date +%Y%m%d).XXX.bak")"
    cp "$hook" "$bak"
    echo "Backed up existing pre-commit to $bak"

    # Write our hook as entry point that chains to backup.
    {
      generate_hook "$PROTECTED"
      cat <<EOF

# --- original hook ---
if [ -f "$bak" ]; then
  if [ -x "$bak" ]; then
    sh "$bak" "\$@"
  else
    . "$bak"
  fi
fi
EOF
    } > "$hook"
    chmod +x "$hook"
    echo "Guard installed. Protected branches: $PROTECTED"
    echo "Original hook is preserved at $bak"
    exit 0
  else
    # No existing hook. Install directly.
    generate_hook "$PROTECTED" > "$hook"
    chmod +x "$hook"
    echo "Guard installed. Protected branches: $PROTECTED"
    exit 0
  fi
}

do_check() {
  local gdir
  gdir="$(git_dir)"
  local hook="$gdir/hooks/pre-commit"
  if is_ours "$hook"; then
    echo "Guard is installed."
    exit 0
  else
    echo "Guard is NOT installed."
    exit 1
  fi
}

do_uninstall() {
  local gdir
  gdir="$(git_dir)"
  local hook="$gdir/hooks/pre-commit"

  if ! is_ours "$hook"; then
    die "Guard is not installed (or was not installed by this tool)."
  fi

  rm "$hook" || die "failed to remove $hook (permission denied?)"

  # Restore latest backup if available.
  local latest
  latest="$(find_backup "$gdir")"
  if [[ -n "$latest" ]]; then
    cp "$latest" "$hook"
    chmod +x "$hook"
    echo "Guard removed. Restored previous hook from $latest"
    rm "$latest" || die "failed to remove backup $latest (permission denied?)"
  else
    echo "Guard removed. No previous hook to restore."
  fi
  exit 0
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage ;;
      --branches)
        [[ $# -lt 2 ]] && die "--branches requires a comma-separated list"
        PROTECTED="$(printf '%s' "$2" | tr ',' ' ')"
        shift 2
        ;;
      --check) do_check ;;
      --uninstall) do_uninstall ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  do_install
}

main "$@"
