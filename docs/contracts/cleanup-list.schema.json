{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cleanup-list.schema.json",
  "title": "wt cleanup --json",
  "description": "The one document `wt cleanup --json` prints, on success and on failure. `rows` is always present. A row's `evidence` is ABSENT when no proof was found (never null, never \"unknown\"); `unknown: true` is the separate flag for \"could not be determined\". `base` is absent when no default branch was found; `base.fetched_at` is absent when no fetch ran or the fetch failed (it is written only after a fetch that worked). `fetch` is absent when no fetch ran (\"not attempted\", including a repository with no origin remote); when present, `ok: false` means the fetch failed and `error` says why. A row's `age_days` is absent when the age could not be determined (0 means a known age under a day). `evidence` only ever holds a proof; `cherry-equivalent` and `patch-id` are reserved in the frozen enum and are never emitted as `evidence` today (weak signals appear as a `weak_signal` reason). On failure `error` is set (a nil error is reported as \"unknown error\"), `rows` is empty and base/fetch/gh are absent. Pinned to wt/internal/cleanup/json.go by wt/cmd/wt/cleanup_contract_test.go; a code or enum added there must be added here and in cleanup-list.sample.json in the same change; cleanup-list.fetch-failed.sample.json shows a run whose fetch failed.",
  "type": "object",
  "required": ["version", "repo", "rows"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "repo": {"type": "string"},
    "base": {
      "type": "object",
      "required": ["default", "ref", "fallback"],
      "additionalProperties": false,
      "properties": {
        "default": {"type": "string"},
        "ref": {"type": "string"},
        "fallback": {"type": "boolean"},
        "fetched_at": {"type": "string"}
      }
    },
    "fetch": {
      "type": "object",
      "required": ["ok"],
      "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "error": {"type": "string"},
        "at": {"type": "string"}
      }
    },
    "gh": {"type": "string", "enum": ["ok", "unavailable", "partial"]},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "error": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {"message": {"type": "string"}}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["kind", "name", "status", "unknown", "reasons", "blockers"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["worktree", "branch", "remote"]},
        "name": {"type": "string"},
        "path": {"type": "string"},
        "branch": {"type": "string"},
        "remote": {"type": "string"},
        "status": {"type": "string", "enum": ["proven", "less_sure", "unique_work", "in_use"]},
        "evidence": {
          "type": "string",
          "enum": ["same-commit", "ancestor", "trees-match", "no-added-changes", "merge-adds-nothing", "pr-tip", "cherry-equivalent", "patch-id"]
        },
        "unknown": {"type": "boolean"},
        "age_days": {"type": "integer"},
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "detail"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": ["no_default_branch", "merge_proof_unavailable", "gates_unavailable", "branch_unknown", "pr_unknown", "pr_merge_unknown", "unpushed_unknown", "cannot_verify", "unpushed", "pr_head_moved", "open_pr", "dirty", "detached_unique", "not_merged", "ignored_files", "weak_signal", "fresh_branch", "base_is_local", "no_merged_pr", "claims_unavailable"]
              },
              "detail": {"type": "string"}
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "detail"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": ["default_branch", "open_pr", "base_of_open_pr", "primary", "current", "held", "locked", "nested", "operation_in_progress", "protected_artifact"]
              },
              "detail": {"type": "string"}
            }
          }
        },
        "pr": {
          "type": "object",
          "required": ["number", "state"],
          "additionalProperties": false,
          "properties": {
            "number": {"type": "integer"},
            "state": {"type": "string", "enum": ["OPEN", "MERGED", "CLOSED"]}
          }
        }
      }
    }
  }
}
