#!/usr/bin/env bash
# shell-wt — execute a shell command in a chosen worktree or branch.
# Usage: shell-wt [-W/--worktree <name>] [--cwd] [--] <command>
# `--` is required when any argument of <command> begins with a dash
# (e.g. `shell-wt -- ls -la`, `shell-wt -- rm --init`): without it wt's own
# flag parser reads that argument as a wt flag, wherever it stands.
exec wt --agent shell "$@"
